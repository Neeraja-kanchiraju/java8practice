package java8practice.com;
//before java 8 
interface Greeting {
    void sayHello();
}
class Main {
    public static void main(String[] args) {
        Greeting g = new Greeting() {
            @Override
            public void sayHello() {
                System.out.println("Hello");
            }
        };
        g.sayHello();
    }
}
---------------output-------------
Hello
